              "id": "name",
              "name": "name",
              "value": "={{ $json.body.data.fields.find(f => f.label === \"Enter Full Name\")?.value || \"\" }}",
              "type": "string"
            },
            {
              "id": "email",
              "name": "email",
              "value": "={{ $json.body.data.fields.find(f => f.label === \"Enter Email Address\")?.value || \"\" }}",
              "type": "string"
            },
            {
              "id": "program",
              "name": "programInterest",
              "value": "={{\n  (() => {\n    const f = $json.body.data.fields.find(\n      f => f.label === \"Which Training Program Are You Interested In?\"\n    );\n    const id = f?.value?.[0];\n    return f?.options?.find(o => o.id === id)?.text || \"\";\n  })()\n}}",
              "type": "string"
            },
            {
              "id": "question",
              "name": "question",
              "value": "={{ $json.body.data.fields.find(f => f.label === \"What would you like to know about our training programs?\")?.value || \"\" }}",
              "type": "string"
            },
            {
              "id": "submittedAt",
              "name": "submittedAt",
              "value": "={{ $json.body.data.createdAt || $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "submissionId",
              "name": "submissionId",
              "value": "={{ $json.body.data.submissionId || $json.body.data.responseId || \"\" }}",
              "type": "string"
            }
          ]
        },
